{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BlackjackStreakSimulator.Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/BlackjackStreakSimulator.Web/bin/Debug/net10.0/BlackjackStreakSimulator.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/BlackjackStreakSimulator.Web",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "BlackjackStreakSimulator.Functions",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:azureFunctions.pickProcess}",
            "preLaunchTask": "run functions host"
        }
    ]
}
