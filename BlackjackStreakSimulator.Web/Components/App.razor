<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["BlackjackStreakSimulator.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/ico" href="favicon.ico" />

    <!-- Open Graph tags - one shared card for the whole app regardless of
         which page a link points at, since that's the realistic use case
         (e.g. sharing the app on LinkedIn) rather than per-page cards.
         Crawlers like LinkedIn's just fetch the raw HTML, no JS execution,
         so these work fine even though Blazor Server renders everything
         server-side on first request anyway. og:image needs an absolute
         URL (crawlers don't resolve it relative to the page), hence the
         hardcoded domain rather than a relative asset path. -->
    <meta property="og:title" content="Blackjack Streak Simulator" />
    <meta property="og:description" content="A .NET/Blazor app simulating a Paroli-style betting progression across thousands of simulated blackjack hands, built end-to-end on Azure by directing Claude Code as an AI implementation partner." />
    <meta property="og:image" content="https://blackjackstreaksimulator-web-azduhkcbewfxasbe.westus3-01.azurewebsites.net/images/blackjackstreaksim_image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/timezone.js"]"></script>
</body>

</html>
