@page "/batchhistory"

<PageTitle>Batch History</PageTitle>

<h1>Batch History</h1>

<MudAlert Severity="Severity.Info" Class="mb-4">
    <ul style="margin: 0; padding-left: 1.2em;">
        <li>
            <b>Drawdown</b> is the biggest drop your bankroll ever took from a high point to a
            later low point during a run — not just where you started versus where you ended.
            For example: a run that climbed to $2,000 at its peak, then later fell to $1,200
            before recovering and eventually reaching the goal, has an $800 drawdown — even
            though it finished well above where it started.
        </li>
        <li>
            <b>Streak Length Frequency</b> only counts losses - including a loss with no active
            streak in progress - plus streaks that hit the configured max length and reset
            automatically. Wins that extend a streak aren't counted on their own; pushes don't
            affect streaks at all and never appear here.
        </li>
    </ul>
</MudAlert>

<MudDataGrid Items="@Histories" T="BatchHistoryEntry">
    <Header>
        <MudTh></MudTh>
        <MudTh></MudTh>
        <MudTh Class="mud-theme-secondary" colspan="7">Configuration</MudTh>
        <MudTh Class="mud-theme-primary" colspan="7">Results</MudTh>
    </Header>
    <Columns>
        <HierarchyColumn T="BatchHistoryEntry" />

        <PropertyColumn Property="x => GetDisplayTime(x.CompletedAtUtc)" Title="Completed" Format="g" InitialDirection="SortDirection.Descending"
                SortBy="x => x.CompletedAtUtc"/>

        <PropertyColumn Property="x => x.InitialBankroll" Title="Initial Bankroll" Format="C0" CellStyle="@ConfigCellStyle" />
        <PropertyColumn Property="x => x.BaseBet" Title="Base Bet" Format="C0" CellStyle="@ConfigCellStyle" />
        <PropertyColumn Property="x => x.BankrollGoal" Title="Goal" Format="C0" CellStyle="@ConfigCellStyle" />
        <PropertyColumn Property="x => x.DecksInShoe" Title="Decks" CellStyle="@ConfigCellStyle" />
        <PropertyColumn Property="x => x.MaxStreakCount" Title="Max Streak" CellStyle="@ConfigCellStyle" />
        <PropertyColumn Property="x => x.SeatCount" Title="Seats" CellStyle="@ConfigCellStyle" />
        <PropertyColumn Property="x => x.BettingMode" Title="Mode" CellStyle="@ConfigCellStyle" />

        <PropertyColumn Property="x => x.RunCount" Title="Runs" CellStyle="@ResultsCellStyle" />
        <PropertyColumn Property="x => x.TimesReachedGoal" Title="Reached Goal" CellStyle="@SuccessCellStyle" />
        <PropertyColumn Property="x => x.TimesBankrupt" Title="Bankrupt" CellStyle="@ErrorCellStyle" />
        <PropertyColumn Property="x => x.AverageHandsPlayedWhenReachedGoal" Title="Avg Hands When Reached Goal" Format="F0" CellStyle="@ResultsCellStyle" />
        <PropertyColumn Property="x => x.AverageHandsPlayedWhenBankrupt" Title="Avg Hands When Bankrupt" Format="F0" CellStyle="@ResultsCellStyle" />
        <PropertyColumn Property="x => x.AverageMaxDrawdownWhenReachedGoal" Title="Avg Drawdown" Format="C0" CellStyle="@ResultsCellStyle" />
        <PropertyColumn Property="x => x.WorstMaxDrawdownWhenReachedGoal" Title="Worst Drawdown" Format="C0" CellStyle="@ResultsCellStyle" />
    </Columns>
    <ChildRowContent>
        <MudText Typo="Typo.subtitle2">Streak Length Frequency - how many times was this streak length hit</MudText>
        @if (context.Item.BettingMode == "Flat")
        {
            <MudSimpleTable Dense="true">
                <tbody>
                    <tr><td><i>N/A - flat betting never changes the bet size, so streak length doesn't affect anything.</i></td></tr>
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            int totalStreakEndingHands = context.Item.StreakLengthFrequencies.Sum(e => e.Count);
            <MudSimpleTable Dense="true">
                <thead>
                    <tr><th>Streak Length</th><th>% of All Streak-Ending Hands (Across All @context.Item.RunCount Runs)</th></tr>
                </thead>
                <tbody>
                    @foreach (StreakLengthFrequencyEntry entry in context.Item.StreakLengthFrequencies.OrderBy(e => e.StreakLength))
                    {
                        <tr><td>@entry.StreakLength</td><td>@(totalStreakEndingHands == 0 ? "—" : (entry.Count / (double)totalStreakEndingHands).ToString("P1"))</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4">Lowest Bankroll Buckets - For each run that reached goal, what was the lowest bankroll as a percentage of the initial bankroll</MudText>
        <MudSimpleTable Dense="true">
            <thead>
                <tr><th>Bucket (% of initial)</th><th>Dollar Range</th><th>Count of @context.Item.TimesReachedGoal</th></tr>
            </thead>
            <tbody>
                @foreach (LowestBankrollBucketEntry entry in context.Item.LowestBankrollBuckets.OrderBy(e => e.BucketFloor))
                {
                    <tr>
                        <td>@(entry.BucketFloor == 0 ? "0%-9%" : $"{entry.BucketFloor}%+")</td>
                        <td>@GetDollarRangeLabel(entry.BucketFloor, context.Item.InitialBankroll)</td>
                        <td>@entry.Count</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </ChildRowContent>
</MudDataGrid>

@code {
    private const string ConfigCellStyle = "background-color: rgba(156, 39, 176, 0.12);";
    private const string ResultsCellStyle = "background-color: rgba(25, 118, 210, 0.12);";

    // Semantic, not decorative - green/red tied to the actual outcome
    // meaning (goal reached vs. bankrupt), same reasoning as MudAlert's
    // Success/Error severities elsewhere in the app.
    private const string SuccessCellStyle = "background-color: rgba(46, 125, 50, 0.12);";
    private const string ErrorCellStyle = "background-color: rgba(211, 47, 47, 0.12);";

    // Same percentage-of-initial bucketing (SimulationLoop.GetLowestBankrollBucket)
    // stays the source of truth - comparable across batches with different
    // initial bankrolls - this just renders each row's own bucket boundaries
    // as concrete dollars using that row's InitialBankroll, alongside the
    // percentage label. Bucket 90 is open-ended (it absorbs 90%-100%
    // inclusive, not just 90%-99%), so its dollar range stays open-ended too.
    private static string GetDollarRangeLabel(int bucketFloor, decimal initialBankroll)
    {
        if (bucketFloor == 90)
        {
            return $"{initialBankroll * 0.90m:C0}+";
        }

        decimal lower = initialBankroll * bucketFloor / 100m;
        decimal upper = initialBankroll * (bucketFloor + 10) / 100m - 1m;
        return $"{lower:C0} - {upper:C0}";
    }
}
