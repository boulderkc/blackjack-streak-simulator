@page "/batchsim"

<PageTitle>Batch Simulation</PageTitle>

<h1>Batch Simulation</h1>

<div>Kick off a batch simulation, see results.</div>

<MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" @onclick="RunSim">Begin Simulation</MudButton>

<div>initbankroll @ConfigState.Current.InitialBankroll basebet @ConfigState.Current.BaseBet bankrollgoal @ConfigState.Current.BankrollGoal 
    maxstreakcount @ConfigState.Current.MaxStreakCount decksinshoe @ConfigState.Current.DecksInShoe seatcount @ConfigState.Current.SeatCount 
    bettingmode @ConfigState.Current.BettingMode</div>