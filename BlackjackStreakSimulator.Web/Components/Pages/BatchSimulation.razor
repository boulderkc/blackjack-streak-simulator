@page "/batchsim"

<PageTitle>Batch Simulation</PageTitle>

<h1>Batch Simulation</h1>

<div>Kick off a batch simulation, see results.</div>

<MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" @onclick="RunBatch" Disabled="@IsRunning">Begin Simulation</MudButton>

@if (IsRunning)
{
    <MudProgressCircular Indeterminate="true" />
}

@if (!IsRunning && LastResult is not null)
{
    <MudAlert Severity="Severity.Success">Batch complete in @LastRunDuration?.TotalSeconds.ToString("F1") seconds.</MudAlert>
}

@if (!IsRunning && ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Error">@ErrorMessage</MudAlert>
}
