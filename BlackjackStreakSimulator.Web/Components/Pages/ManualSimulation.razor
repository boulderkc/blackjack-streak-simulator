@page "/manualsim"


<PageTitle>Manual Simulation</PageTitle>

<h1>Manual Simulation</h1>

<div>Begin and observe a simulation in progress.</div>

<MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="RunTest">Begin Sim</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" @onclick="NextRound">Next Round</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Primary">Finish Sim Automatically</MudButton>

<div class="overflowwide">
    <div id="page">
        <div class="dealer">
            <h2 class="playertitle">Dealer</h2>
            <div class="hand">
                @foreach (Card card in currentRun?.LastDealerHand?.Cards ?? [])
                {
                    <PlayingCard Card="@card" />
                }
            </div>

        </div>
        <div class="player1">
            <h2 class="playertitle">Player 1 - Tracked Player</h2>
            <div>Bankroll: @currentRun?.Seats[0].Bankroll.ToString("C")</div>

            @foreach (Hand hand in currentRun?.Seats[0]?.Hands ?? [])
            {
                <div class="hand-row">
                    <div class="hand">
                        @foreach (Card card in hand?.Cards ?? [])
                        {
                            <PlayingCard Card="@card" />
                        }
                    </div>
                    <div class="hand-info">
                        <div>
                            Bet: @hand.Bet.ToString("C")                          
                        </div>
                        <div>Hand value: @hand.Value</div>
                        <div>Result: @GetResultText(hand)</div>
                    </div>
                </div>
            }
        </div>
