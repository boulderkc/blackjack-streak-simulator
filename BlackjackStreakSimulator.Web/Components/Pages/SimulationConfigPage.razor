@page "/simconfig"
@using BlackjackStreakSimulator.Web.Services
@inject SimulationConfigState ConfigState
@inject StepThroughSimulationState RunState

<PageTitle>Simulation Configuration</PageTitle>

<h1>Simulation Configuration</h1>
<h3 class="mb-6">These configurations will be used the next time you run the simulation in either batch or step-through modes.
</h3>

<div class="terminology-flow">
    <div class="term-box">
        <h4>Round</h4>
        <p>One hand dealt and settled</p>
    </div>
    <div class="term-arrow">many make a →</div>
    <div class="term-box">
        <h4>Run</h4>
        <p>One seat's play, start to bankrupt or goal</p>
    </div>
    <div class="term-arrow">many make a →</div>
    <div class="term-box">
        <h4>Batch</h4>
        <p>Many Runs, aggregated together</p>
    </div>
</div>

@if (RunState.IsRunActive)
{
    <MudAlert Severity="Severity.Warning">Configuration is disabled while a step-through run is in progress.</MudAlert>
}

<h4 style="color: var(--mud-palette-secondary);">Money</h4>
<div Class="num-input-size">
    <MudNumericField HideSpinButtons="true" @bind-Value="ConfigState.Current.InitialBankroll" Label="Initial bankroll"
                     Variant="Variant.Outlined" Min="@SimulationConfig.InitialBankrollMin" Disabled="@RunState.IsRunActive" />
</div>

<div Class="num-input-size">
    <MudNumericField HideSpinButtons="true" @bind-Value="ConfigState.Current.BankrollGoal" Label="Bankroll goal"
                     Variant="Variant.Outlined" Min="@SimulationConfig.BankrollGoalMin" Disabled="@RunState.IsRunActive" />
</div>
@if (ConfigState.GetErrorFor(nameof(SimulationConfig.BankrollGoal)) is string bankrollGoalError)
{
    <div class="field-error">@bankrollGoalError</div>
}

<div Class="num-input-size">
    <MudNumericField HideSpinButtons="true" @bind-Value="ConfigState.Current.BaseBet" Label="Base bet"
                     Variant="Variant.Outlined" Min="@SimulationConfig.BaseBetMin" Disabled="@RunState.IsRunActive" />
</div>
@if (ConfigState.GetErrorFor(nameof(SimulationConfig.BaseBet)) is string baseBetError)
{
    <div class="field-error">@baseBetError</div>
}

<h4 class="mt-6" style="color: var(--mud-palette-tertiary);">Table</h4>
<div Class="num-input-size">
    <MudNumericField @bind-Value="ConfigState.Current.DecksInShoe" Label="Decks in shoe" Variant="Variant.Outlined"
                     Min="@SimulationConfig.DecksInShoeMin" Max="@SimulationConfig.DecksInShoeMax" Disabled="@RunState.IsRunActive" />
</div>
@if (ConfigState.GetErrorFor(nameof(SimulationConfig.DecksInShoe)) is string deckCountError)
{
    <div class="field-error">@deckCountError</div>
}

<div Class="num-input-size">
    <MudNumericField @bind-Value="ConfigState.Current.SeatCount" Label="Number of players, including target player"
                     Variant="Variant.Outlined" Min="@SimulationConfig.SeatCountMin" Max="@SimulationConfig.SeatCountMax" Disabled="@RunState.IsRunActive" />
</div>

<h4 class="mt-6" style="color: var(--mud-palette-info);">Simulation</h4>
<div Class="num-input-size">
    <MudNumericField @bind-Value="ConfigState.Current.MaxStreakCount" Label="Max streak count"
                     Variant="Variant.Outlined" Min="@SimulationConfig.MaxStreakCountMin" Max="@SimulationConfig.MaxStreakCountMax"
                     Disabled="@(RunState.IsRunActive || ConfigState.Current.BettingMode == BettingMode.Flat)" />
</div>
<div Class="num-input-size">
    <MudNumericField @bind-Value="ConfigState.Current.NumberOfRunsInBatch" Label="Number of runs in batch" Variant="Variant.Outlined"
                     Min="@SimulationConfig.NumberOfRunsInBatchMin" Max="@SimulationConfig.NumberOfRunsInBatchMax" Disabled="@RunState.IsRunActive" />
</div>
<div class="betting-mode-size">
    <MudSelect @bind-Value="ConfigState.Current.BettingMode" Label="Betting mode" Variant="Variant.Outlined"
               Disabled="@RunState.IsRunActive">
        <MudSelectItem Value="@(BettingMode.Streak)">Streak</MudSelectItem>
        <MudSelectItem Value="@(BettingMode.Flat)">Flat</MudSelectItem>
    </MudSelect>
</div>

